~Server {
    host: any(ip, hostname),
    port: <int, range(1, 65535)>,
    reload: bool,
}

~AppConfig {
    server: Server,
    media_dir: <path, dir>,
    static_dir: <path, dir>,
    ui_css: <path, file>,
    ui_js: <path, file>,
    templates_dir: <path, dir>,
    meta_cache: <path?, dir?> = noexist,
}